{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>udondan/renovate-config"],
  "packageRules": [
    {
      "description": "Own package, no need to wait for the minimum release age.",
      "matchPackageNames": ["aws-cloudformation-custom-resource"],
      "minimumReleaseAge": null
    },
    {
      "description": "The Lambda function in lambda/ is bundled into the construct, so its dependencies ship to users.",
      "matchManagers": ["npm"],
      "matchFileNames": ["lambda/package.json"],
      "matchDepTypes": ["dependencies"],
      "semanticCommitType": "build"
    }
  ]
}

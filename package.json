{
  "name": "cdk-ec2-key-pair",
  "description": "CDK Construct for managing EC2 key pairs",
  "version": "5.2.0",
  "license": "Apache-2.0",
  "author": {
    "name": "Daniel Schroeder",
    "url": "https://www.udondan.com/",
    "twitter": "udondan"
  },
  "awscdkio": {
    "twitter": "udondan"
  },
  "homepage": "https://github.com/udondan/cdk-ec2-key-pair",
  "repository": {
    "type": "git",
    "url": "https://github.com/udondan/cdk-ec2-key-pair.git"
  },
  "bugs": {
    "url": "https://github.com/udondan/cdk-ec2-key-pair/issues"
  },
  "keywords": [
    "aws",
    "cdk",
    "aws-cdk",
    "aws-cdk-construct",
    "ec2",
    "ec2-key-pair",
    "cloudformation",
    "cloudformation-custom-resource"
  ],
  "stability": "stable",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "build": "jsii",
    "build:watch": "jsii -w",
    "package": "jsii-pacmak",
    "prepackage": "jsii && lambda/build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "jsii": {
    "excludeTypescript": [
      "lambda",
      "test",
      "tests",
      "vitest.config.mts"
    ],
    "outdir": "dist",
    "targets": {
      "python": {
        "distName": "cdk-ec2-key-pair",
        "module": "cdk_ec2_key_pair"
      },
      "dotnet": {
        "namespace": "CDK.EC2.KeyPair",
        "packageId": "CDK.EC2.KeyPair"
      },
      "java": {
        "package": "com.udondan.cdkEc2KeyPair",
        "maven": {
          "groupId": "com.udondan",
          "artifactId": "cdk-ec2-key-pair"
        }
      },
      "go": {
        "moduleName": "udondan.github.io/cdk-ec2-key-pair/go",
        "packageName": "cdkec2keypair"
      }
    }
  },
  "workspaces": [
    "test"
  ],
  "devDependencies": {
    "@aws-sdk/client-ec2": "3.1177.0",
    "@aws-sdk/client-secrets-manager": "3.1177.0",
    "@aws-sdk/client-sts": "3.1177.0",
    "@types/node": "26.6.10",
    "@types/sshpk": "1.17.5",
    "@typescript-eslint/eslint-plugin": "8.74.0",
    "@typescript-eslint/parser": "8.74.0",
    "@vitest/coverage-v8": "5.1.2",
    "aws-cdk-lib": "2.278.0",
    "aws-cloudformation-custom-resource": "5.1.5",
    "constructs": "10.8.1",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "jsii": "6.0.25",
    "jsii-pacmak": "1.143.0",
    "prettier": "3.10.1",
    "publib": "0.3.15",
    "sshpk": "1.18.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vitest": "5.1.2"
  },
  "peerDependencies": {
    "aws-cdk-lib": "^2.224.0",
    "constructs": "^10.0.0"
  },
  "overrides": {
    "minimatch": "^11.0.3"
  }
}
